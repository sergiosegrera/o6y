{
  "name": "o6y",
  "version": "0.7.0",
  "description": "Typed, validated, interlinked markdown memory (ontology wiki) for the pi coding agent",
  "type": "module",
  "license": "MIT",
  "author": "Sergio Segrera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergiosegrera/o6y.git"
  },
  "homepage": "https://github.com/sergiosegrera/o6y#readme",
  "bugs": {
    "url": "https://github.com/sergiosegrera/o6y/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "memory",
    "wiki",
    "ontology",
    "agent"
  ],
  "files": [
    "index.ts",
    "src",
    "bin",
    "dist",
    "skills",
    "README.md",
    "SPEC.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "o6y": "./dist/o6y.js"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && bun build src/cli/o6y.ts --target=node --outdir dist --splitting --packages external --entry-naming \"[name].[ext]\" --chunk-naming \"chunk-[hash].[ext]\" --banner \"#!/usr/bin/env node\"",
    "o6y": "bun src/cli/o6y.ts",
    "view": "bun src/cli/o6y.ts view",
    "eval": "bun evals/run.ts"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "typescript": "^7"
  }
}
