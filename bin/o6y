#!/bin/sh
# The o6y pi extension puts this directory on the agent's PATH. Runs the bundled CLI with the
# Node that runs pi when known (O6Y_NODE), else whatever node or bun is on PATH.
cli="$(dirname "$0")/../dist/o6y.js"
if [ -n "$O6Y_NODE" ]; then exec "$O6Y_NODE" "$cli" "$@"; fi
if command -v node >/dev/null 2>&1; then exec node "$cli" "$@"; fi
exec bun "$cli" "$@"
